# Copy to config/cloudflare-tunnel.env and fill in exactly one mode.

# Recommended dashboard-managed tunnel mode:
# CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-token

# Locally managed named tunnel mode:
# CLOUDFLARE_TUNNEL_NAME=messages-assistant
# CLOUDFLARE_TUNNEL_CONFIG=/absolute/path/to/config/cloudflared/config.yml
